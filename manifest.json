{
  "apiVersion": "2",
  "name": "mcp-example-http",
  "contextPath": "mcp-example-http",
  "key": "mcp-example-http-application-key",
  "version": "2.0.0",
  "provider": {
    "name": "Cumulocity GmbH"
  },
  "type": "MICROSERVICE",
  "isolation": "MULTI_TENANT",
  "scale": "NONE",
  "requestedResources": {
    "memory": "128M",
    "cpu": "100m"
  },
  "description": "An example MCP application demonstrating AI Tools.",
  "resources": {
    "memory": "512M",
    "cpu": "1000m"
  },
  "roles": [],
  "requiredRoles": [
    "ROLE_INVENTORY_READ",
    "ROLE_USER_MANAGEMENT_READ",
    "ROLE_OPTION_MANAGEMENT_ADMIN",
    "ROLE_OPTION_MANAGEMENT_READ"
  ],
  "exposeMcpServers": [
    {
      "name": "mcp-example-http-exposed-server",
      "description": "Custom MCP example HTTP server",
      "url": "/service/mcp-example-http/mcp",
      "type": "http",
      "sendAuthentication": false
    }
  ],
  "agents": {
    "example-agent": "agents/example-agent.json"
  }
}
